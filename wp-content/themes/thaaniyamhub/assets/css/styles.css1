    min-height: 534px;
}
.card-media-info{
    position: absolute;
    top: 0;
    right: 0;
    width: 55%;
}
.our-media-inner{
    position: relative;
    width: 100%;
    height: 534px;
}
.our-media-inner img{
    max-width: 100%;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center left;
}
.our-blog-inner{
    align-items: center;
    display: flex;
}

.main-heading-title{
