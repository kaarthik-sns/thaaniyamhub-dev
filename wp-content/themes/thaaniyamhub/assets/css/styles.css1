}
.ml-heading {
  display: flex;
  align-items: center;
  gap: 8px;
}

.icon-wrap {
  position: relative;
  display: inline-block;
  width: 65px;
  height: 65px;
}

.icon-wrap img {
  width: 100%;
  height: 100%;
  position: relative;
  z-index: 2; 
}

.glow-dot {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 50px;
  height: 50px;
  background: rgba(19, 84, 134, 0.6); 
  border-radius: 50%;
  transform: translate(-50%, -50%);
  z-index: 1;
  animation: pulseGlow 1.8s ease-out infinite;
}

@keyframes pulseGlow {
  0% {
    transform: translate(-50%, -50%) scale(0.6);
    opacity: 0.6;
  }
  70% {
    transform: translate(-50%, -50%) scale(1.4); 
    opacity: 0; 
  }
  100% {
    opacity: 0;
  }
}
