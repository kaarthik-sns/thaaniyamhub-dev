@import url('../fonts/font-style.css');

:root {
  --background-white: #ffffff;
  --white: #ffffff;
  --primary-color: #5C5C5C;
  --font-Rethink-Sans: 'Rethink Sans';
  --btn-primary-bg: #135486;
  --btn-secondary-bg: #CFA859;
}
html{
position: relative;
}
body {
    margin: 0;
    padding: 0;
    position: relative;
    font-weight: normal;
    font-family: 'Rethink Sans';
    font-size: 18px;
}

a{
    color: #135486;
    text-decoration: none;
}
a:hover{
     text-decoration: none;
}
.top-header {
    margin: 0;
    display: block;
    padding: 10px 0;
    width: 100%;
    position: relative;
    z-index: 1030;
    background:#fff;  
    box-shadow: rgba(0, 0, 0, 0.04) 0px 3px 5px; 
}
html:has(.mfp-iframe-holder),
html:has(.mfp-zoom-out-cur){
    overflow: auto!important;
    margin:0!important;
}
.header-part-info {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
}
.top-header.fixed {
    position: fixed;
    top: 0;
    left: 0;
    background-color:#fff; 
}
.right-part {
    float: right;
}
.top-logo {
    max-width: 394px;
    float: left;
    margin: 0 56px 0 0;
    position: relative;
}
.top-logo a {
    padding: 0;
    margin-right: 0px;
}
.top-logo a img {
    max-width: 100%;
    border: 0;
}
.top-header .navbar {
    padding: 10px 16px;     
}
.top-header.fixed  .navbar{
    border-color: transparent;
}
.top-store-info {
    min-height: 57px;
    background-color: #EDFED8;
    -webkit-border-bottom-right-radius: 25px;
    -webkit-border-bottom-left-radius: 25px;
    -moz-border-radius-bottomright: 25px;
    -moz-border-radius-bottomleft: 25px;
    border-bottom-right-radius: 25px;
    border-bottom-left-radius: 25px;
    margin-top: -1px;
    display: flex;
    align-items: center;
    padding: 0 10px;
    float: right;
}
.header-menu-part {
    float: right;
    clear: both;
    margin: 0 0;
}
#main-menu ul {
    margin: 0px;
    padding: 0;
}
#main-menu ul li {
    padding: 0 10px;
    margin: 0;
}
#main-menu ul li a {
    color:var(--primary-color);  
    font-family:var(--font-Rethink-Sans);
    font-size: 18px;
    font-weight:500;
    line-height: normal;
    padding: 0 15px;
    text-decoration: none;
}
#main-menu ul li a:hover {
    color: #135486;
}
#main-menu ul li.current-menu-item a{
    color: #135486;  
}


.top-location-info{
    text-align: right;
    margin: 0 0 15px;
}
.top-location-info span{
    color: var(--primary-color);
    font-family:var(--font-Rethink-Sans);
    font-size: 16px;
    font-weight: 500;
    line-height: normal;
    margin: 0;
}
.top-location-info span .fa-location-dot{ color:#CFA859; margin-right: 5px;}



/***/
/* Submenu Base */
.sub-menu,
.sub-sub-menu {
  display: none;
  position: absolute;
  top: 100%;
  left: 0;
  background: #fff;
  list-style: none;
  margin: 0 0 0;
  padding:10px 0;
  min-width: 250px;
  border: 1px solid #ddd;
  border-radius: 6px;
  box-shadow: 0 4px 8px rgba(0,0,0,0.08);
  z-index: 999;
}

/* Submenu Items */
.menu-item-has-children{
    position: relative;
}
#main-menu .sub-menu{
     margin: 12px 0 0;
}
#main-menu  .sub-menu li,
#main-menu .sub-sub-menu li {
  position: relative;
}
#main-menu  .sub-menu li:not(:last-child),
#main-menu .sub-sub-menu li:not(:last-child) {
    border-bottom: 1px solid #ccc;
}

#main-menu .sub-menu .nav-link,
#main-menu  .sub-sub-menu .nav-link {
  padding: 15px 15px;
  font-size: 18px;
  color:var(--primary-color);
}

#main-menu .sub-menu .nav-link:hover,
#main-menu .sub-sub-menu .nav-link:hover {
  background: #f8f9fa;
  color: #135486;
}

.sub-sub-menu {
  top: 0;
  left: 100%;
  margin-left: 2px;
  border-radius: 6px;
}

.menu-item.menu-open > .sub-menu,
.menu-item.menu-open > .sub-sub-menu {
  display: block;
  animation: dropdownFade 0.25s ease;
  background-color: #fff;
  box-shadow: rgba(149, 157, 165, 0.2) 0px 8px 24px;
}

#main-menu .sub-menu li a > .dropdown-toggle-icon{
    position: absolute;
    right: 10px;
}
/* Animation */
@keyframes dropdownFade {
  from { opacity: 0; transform: translateY(-5px); }
  to { opacity: 1; transform: translateY(0); }
}

/**/



.top-search{
    margin: 0;
    padding: 0 20px;
    position: relative;
}
.top-search img{
    max-width: 100%;
}
.top-right-link{
    margin: 0;
    padding: 0;
}
.right-btn-link{
    margin: 0;
    display: flex;
}
.right-btn-link li {
    list-style-type: none;
    display: inline-block!important;
    margin:0 22px !important;
}
.right-btn-link li:last-child{
    margin-right: 0!important;
}
  .right-btn-link li a{
        border-radius: 50px;
        padding: 30px 50px;
        justify-content: center;
        align-items: center;
        gap: 10px;    
        display: flex;  
        font-family:'Mulish';
        font-size: 18px;
        font-weight: 500;
        line-height: 30px; 
        border: 1px solid #CFA859;
   }
    .right-btn-link li.cta-stud a{
        background: #CFA859;
        color: #fff!important;
    }
    .right-btn-link li.cta-stud a:hover{
        color: #fff!important;  
        background: #135486; 
         border: 1px solid #135486;   
    }
    .right-btn-link li.cta-cal a{
        color: #fff!important;
        border: 1px solid #135486;
        background: #135486;
    }
    .right-btn-link li.cta-cal a:hover{
        color: #fff!important;
        background: #CFA859;
        border: 1px solid #CFA859;
    }
    .right-btn-link li a img{
        max-width: 24px;
        width: 100%;
        fill: #fff;
        filter: brightness(0) invert(1);
    }
    .right-btn-link li a:hover img {
      fill: #fff;
      filter: brightness(0) invert(1);
    }


