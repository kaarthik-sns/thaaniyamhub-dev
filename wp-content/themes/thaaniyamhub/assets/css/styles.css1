}



/* office page style */
.inner-banner-bg{
    background-image: url(../images/office-banner-bg.png);
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
    overflow: hidden;
    min-height: 431px;
    align-items: center;
    border-radius: 40px;
    
}
.inner-banner-content{
    padding: 0 0 0 80px;
    max-width: 850px;
}
.inner-banner-content h1{
    color: #CFA859;
    font-family: "Rethink Sans";
    font-size: 42px;
    font-weight: 500;
    line-height: normal;
    letter-spacing: -1px;
}
.inner-banner-content p{
    color: #FFF;
    font-family: "Rethink Sans";
    font-size: 20px;
    font-weight: 500;
    line-height: 33px; 
}
.inner-banner-media {float: right;}
.inner-banner-media img {max-width: 100%;}
.about-content-sec{padding: 60px 0;}
.about-content-sec{
    background-repeat: no-repeat;
    background-size: cover;
    background-position: top left;
}
.about-content h2{
    color: #5C5C5C;
    font-family: "Rethink Sans";
    font-size: 42px;
    font-weight: 500;
    line-height: normal;
    letter-spacing: -1px;
    margin-bottom: 30px;
}
.about-content p{
    color: #5C5C5C;
    font-family: "Rethink Sans";
    font-size: 20px;
    font-weight: 500;
    line-height: 33px;
}
.staff-sec{padding: 60px 0;}
.staff-content { max-width: 730px;}
.office-bg-sec{
    background-image: url(../images/office.png);
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
    overflow: hidden;
    /* min-height: 436px; */
}
.office-info-content{
    align-items: center;
    padding: 60px 0;
}
.office-hours-table table {
  width: 100%;
  border-collapse: collapse;
  border-radius: 15px;
  overflow: hidden; 
  box-shadow: 0 0 10px rgba(0, 0, 0, 0.05); 
}
.office-hours-table table tr:not(:last-child) {
  border-bottom: 1px solid #ddd;
}
.office-hours-table .day,
.office-hours-table .time {
    background-color: #fff; 
    color: #5C5C5C;
    font-family: "Rethink Sans";
    font-size: 20px;
    font-weight: 500;
    line-height: normal; 
    padding: 15px 16px;
    width: 40%;
    border-radius: 0; 
}
.office-hours-table .day {
  background-color: #d1ac69;
  color: white;
}
.office-hours-table span {
    font-size: 13px;
}
.insurance-con-sec{background: #FDF6E9;}
.finance-con-sec{background: #F0F9FF;}
.insurance-img{float: right;}
.insurance-img img{object-fit: cover;}
.insurance-con, .finance-con{
    max-width: 600px;
    margin: 0 auto;
}
.insurance-con{padding: 20px 20px 20px 0;} 
.finance-con{padding: 20px 0px 20px 20px;}
.common-text { position: relative;}
.left-media {
    height: 100%;
    display: flex;
    align-items: stretch;
}

.left-media img {
    object-fit: cover;
    height: 100%;
    width: 100%;
}
.smile-content-info{background-color: #CFA859;}
.smile-content{max-width: 600px;padding: 60px;}
.smile-content h6{
    color: #FFF;
    font-family: "Rethink Sans";
    font-size: 13px;
    font-weight: 500;
    line-height: 20.15px; 
    letter-spacing: 3px;
    text-transform: uppercase;
}
.smile-content h3{
    color: #FFF;
    font-family: "Rethink Sans";
    font-size: 56px;
    font-weight: 500;
    line-height: 64.4px; 
    letter-spacing: -1px;
}
.smile-content p{ 
    color: #FFF;
    font-family: "Rethink Sans";
    font-size: 20px;
    font-style: normal;
    font-weight: 500;
    line-height: 28px; 
    margin-bottom: 25px;
}
.smile-content a{
    border-radius: 25px;
    background: #135486;
    color: #FFF;
    font-family: "Rethink Sans";
    font-size: 16px;
    font-weight: 700;
    line-height: 24px;
    padding: 12px 16px;
}
.img-align-left .grid-media{order: 1;}
.img-align-left .grid-content{order: 2;}
.img-align-right .grid-media{order: 2;}
.img-align-right .grid-content{order: 1;}

/* orthodontics style */
.common-banner-bg{
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
    align-items: center;
    border-radius: 40px;
    min-height: 400px;
}
.common-banner-content{padding: 0 60px;}

.orthodontics-grid-sec{
    background-position:center;
    background-size: cover;
    background-repeat: no-repeat;
    padding: 70px 0;
}
.orthodontics-grid-media {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
}
.orthodontics-grid-media video {
    width: 100%;
    height: 100%;
    border-radius: 20px;
    object-fit: cover;
}
.orthodontics-grid-media h2{
