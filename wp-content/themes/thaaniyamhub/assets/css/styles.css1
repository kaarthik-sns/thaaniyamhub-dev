    font-family: "Rethink Sans";
    font-size: 56px;
    font-weight: 500;
    line-height: 64.4px; 
    letter-spacing: -1px;
    margin: 0 0 8px;
}
.env-pro-list h5{
    color: #FFF;
    font-family: "Rethink Sans";
    font-size: 20px;
    font-weight: 600;
    line-height: 25px;
    margin: 0 0 10px;
    padding: 0;
}
.env-pro-list p{
    color: rgba(255, 255, 255, 0.80);
    font-family: "Rethink Sans";
    font-size: 18px;
    font-weight: 500;
    line-height: 33px;
    padding: 0;
    margin: 0;
    
}
.env-pro-list:not(:last-child):after{
    content: " ";
    height: 100%;
    width: 1px;
    position: absolute;
    right:-1px;
    top: 0;
    background-color: #EAC57A;
}

.env-slider-arrow{
    position: absolute;
    bottom: 30px;
    right: 30px;
}
.env-slider-arrow .slick-arrow{
    cursor: pointer;
}
.env-slider-arrow .slick-arrow svg{
    width: 40px;
    height: 40px;
    transition: fill 0.3s ease;
}
.env-slider-arrow .slick-arrow:hover svg {
      filter: brightness(0) saturate(100%) invert(11%) sepia(70%) saturate(3137%) hue-rotate(207deg) brightness(92%) contrast(103%);
      opacity: 0.5;
}

/**/
.our-testimonials{
    position: relative;
    width: 100%;
    display: block;
    padding: 60px 0;
}
.tm-top-title{
    position: relative;
    text-align: center;
}
.tm-top-title h3{
    color: #5C5C5C;
    text-align: center;
    font-family: "Rethink Sans";
    font-size: 13px;
    font-weight: 500;
    line-height: 20.15px;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin: 0;
}

.testimonials-list{
    border-radius: 40px;
    background: #EFF7FD;
    position: relative;
    margin: 50px auto 0;
    display: block;
    max-width: 900px;
    width: 100%;
    text-align: center;
    padding: 40px 70px;
    min-height: 464px;
   
}
.testimonials-list-itmes{
    position: relative;
    display: flex!important;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px;
    align-items: center;
    height: 100%;
}
.testimonials-list-itmes img{
    max-width: 100%;
    width: 95px;
    height: 95px;
    border-radius: 50%;
    margin: 0;
}
.testimonials-list-itmes p{
    color: #5C5C5C;
    text-align: center;
    font-family: "Rethink Sans";
    font-size: 30px;
    font-style: normal;
    font-weight: 500;
    line-height: 40.5px;
    margin: 0;
}
.testimonials-list-itmes h6{
    color: #222;
    font-family: "Rethink Sans";
    font-size: 16px;
    font-weight: 500;
    line-height: 26.4px; 
    margin: 0;
}

.testimonials-list .slick-arrow{
    position: absolute;
    top: 50%;
    width: 60px;
    height: 60px;
    line-height: 20px;
    border-radius: 50%;
    border: 1px solid #DFE4E1;
    background-color: #fff;
    opacity: 0.5;
    transition: fill 0.3s ease;
}
.testimonials-list .slick-arrow:hover{
    opacity: 1;
}
.testimonials-list .slick-prev{
    left:-90px;
}
.testimonials-list .slick-next{
    right:-90px;
}

#testimonials-slider .slick-dots {
  position: absolute;
  bottom: 18px; 
  left: 50%;
  transform: translateX(-50%);
  display: flex !important;
  justify-content: center;
  align-items: center;
  list-style: none;
  margin: 0;
  padding: 0;
  gap: 8px; 
}
#testimonials-slider .slick-dots li {
  display: inline-block;
  width: 12px;
  height: 12px;
  margin: 0;
  padding: 0;
  cursor: pointer;
}

#testimonials-slider .slick-dots li button {
  font-size: 0; 
  line-height: 0;
  display: block;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: #CFA859;
  border: none;
  outline: none;
  cursor: pointer;
  transition: background 0.3s ease;
}

#testimonials-slider .slick-dots li.slick-active button {
  background:#135486;
  width: 14px;
  height: 14px;
}
#testimonials-slider .slick-dots li button:hover {
  background: #135486;
}


