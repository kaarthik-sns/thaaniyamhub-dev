}

.about-content.plain-content-center {
		max-width: 1280px;
		text-align: center;
		margin: 0 auto;
	}
.orthodontics-grid-align-left .orthodontics-media-info{order:1;}
.orthodontics-grid-align-left .orthodontics-content-info{order:2;}
.orthodontics-grid-align-right .orthodontics-media-info{order:2;}
.orthodontics-grid-align-right .orthodontics-content-info{order:1;}

.ort-care{
    position: relative;
    max-width: 858px;
    margin: 0px auto 40px; 
}
.ort-care video{
    width: 100%;
    height: 100%;
    border-radius: 20px;
    object-fit: cover;
}

.dis-infoist-list{
    position: relative;
    width: 100%;
    display: block;
    background-position: top center;
    background-size: cover;
}
.dis-inner-list{
    max-width: 750px;
    width: 100%;
    position: relative;
    padding:50px 0;
}
.dis-inner-list h3{
    color: #FFF;
    font-family: "Rethink Sans";
    font-size: 42px;
    font-weight: 500;
    line-height: normal;
    letter-spacing: -1px;
    margin: 0 0 15px;
}
.dis-inner-list  p{
    color: #FFF;
    font-family: "Rethink Sans";
    font-size: 20px;
    font-weight: 500;
    line-height: 33px; 
    margin: 0 0 15px;
}
.dis-inner-list ul{
    display: block;
    list-style-type: none;
    margin: 0 0 15px;
    padding: 0;
}
.dis-inner-list ul li{
    list-style-type: none;
    margin: 0;
    padding: 0;
    color: #FFF;
    font-family: "Rethink Sans";
    font-size: 20px;
    font-weight: 500;
    line-height: 40px; 
}
.dis-inner-list ul li img{
    margin-right: 5px;
    max-width: 100%;
}
.dis-cta-info{
    display: flex;
    position: relative;
    gap:30px;
    margin: 34px 0 0;
}

.art-slider-con .slick-arrow{
    color:var(--primary-color);
}

.art-slider-con .slick-arrow {
    width: 20px;
    height: 20px;
    background-color:var(--primary-color);
    border-radius: 50%;
    display: flex !important;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 12px;
    z-index: 2;
    transition: background-color 0.3s ease, transform 0.2s ease;
    position: absolute;
    top: 45%;
    cursor: pointer;
}
.art-slider-con .slick-arrow:hover {
    background-color: #444;
    transform: scale(1.1);
}
.art-slider-con .slick-prev {
    left: -50px; 
}
.art-slider-con .slick-next {
    right: -50px; 
}
.art-slider-con .article-list img{
    border-radius: 20px;
}
.art-slider-con .article-list{
    padding: 0 20px;
}

.art-slider-con .slick-dots {
        position: relative;
        bottom: 0;
        display: flex !important;
        justify-content: center;
        padding: 10px 0;
    }
.art-slider-con  .slick-dots li {
        margin: 0 5px;
        list-style-type: none;
    }
.art-slider-con .slick-dots li button {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background-color: #ccc;
        padding: 0;
        border: none;
        font-size: 0; 
        cursor: pointer;
        transition: background-color 0.3s ease;
    }
.art-slider-con .slick-dots li.slick-active button {
        background-color:var(--primary-color); 
}

.dental-ser-list{
    position: relative;
}
.dental-ser-inner{
    position: relative;
