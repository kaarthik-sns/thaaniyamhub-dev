    margin-bottom: 25px;
}
.orthodontics-grid-content h2{
    color:var(--primary-color);
    font-family: "Rethink Sans";
    font-size: 42px;
    font-weight: 500;
    line-height: normal;
    letter-spacing: -1px;
    margin-bottom: 25px;
}
.orthodontics-grid-content h4{
    color:var(--primary-color);
    font-family: "Rethink Sans";
    font-size: 30px;
    font-weight: 500;
    line-height: normal;
    letter-spacing: -1px;
}
.orthodontics-grid-content p{
    color:#5D5D5D;
    font-family: "Rethink Sans";
    font-size: 20px;
    font-weight: 500;
    line-height: 33px;
    margin-bottom: 25px; 
}
.orthodontics-grid-media img{
    max-width: 100%;
    border-radius: 20px;
}
.articles-sec{background: #FFFDFB;padding:60px 0;}
.article-list-info{padding: 25px 0;}
.article-list-info h3{
    color:#5D5D5D;
    font-family: "Rethink Sans";
    font-size: 25px;
    font-weight: 500;
    line-height: normal;
    letter-spacing: -1px;
    margin-bottom: 30px;
}
.article-list-info p{
    color:var(--primary-color);
    font-family: "Rethink Sans";
    font-size: 20px;
    font-weight: 500;
    line-height: 33px;
    max-width: 450px;
    margin-bottom: 30px; 
}
.article-list-info a{
    color: #FFF;
    font-family: "Rethink Sans";
    font-size: 16px;
